        "def entropy(labels):\n",
        "\n",
        "    values, counts = np.unique(\n",
        "        labels,\n",
        "        return_counts=True\n",
        "    )\n",
        "\n",
        "    total = len(labels)\n",
        "    entropy_value = 0\n",
        "\n",
        "    for count in counts:\n",
        "\n",
        "        probability = count / total\n",
        "\n",
        "        entropy_value -= (\n",
        "            probability * log2(probability)\n",
        "        )\n",
        "\n",
        "    return entropy_value"
      ],
