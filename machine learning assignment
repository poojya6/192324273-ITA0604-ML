        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from math import log2\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.tree import DecisionTreeClassifier, plot_tree, export_text\n",
        "from sklearn.metrics import (\n",
        "    confusion_matrix,\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    classification_report\n",
        ")\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "print(\"Libraries imported successfully!\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Number of records\n",
        "n = 200\n",
        "\n",
        "# Generate water-quality attributes\n",
        "pH = np.random.choice(\n",
        "    [\"Acidic\", \"Neutral\", \"Alkaline\"], n\n",
        ")\n",
        "\n",
        "turbidity = np.random.choice(\n",
        "    [\"Low\", \"High\"], n\n",
        ")\n",
        "\n",
        "tds = np.random.choice(\n",
        "    [\"Low\", \"High\"], n\n",
        ")\n",
        "\n",
        "chlorine = np.random.choice(\n",
        "    [\"Adequate\", \"Low\"], n\n",
        ")\n",
        "\n",
        "microbial = np.random.choice(\n",
        "    [\"Absent\", \"Present\"], n\n",
        ")\n",
        "\n",
        "source = np.random.choice(\n",
        "    [\"Protected\", \"Unprotected\"], n\n",
        ")\n",
        "\n",
        "# Calculate risk score\n",
        "risk_score = (\n",
        "    (pH != \"Neutral\").astype(int)\n",
        "    + (turbidity == \"High\").astype(int)\n",
        "    + (tds == \"High\").astype(int)\n",
        "    + (chlorine == \"Low\").astype(int)\n",
        "    + (microbial == \"Present\").astype(int)\n",
        "    + (source == \"Unprotected\").astype(int)\n",
        ")\n",
        "\n",
        "# Classification rule\n",
        "# 0, 1 or 2 risk factors -> Safe\n",
        "# More than 2 -> Needs Treatment\n",
        "\n",
        "target = np.where(\n",
        "    risk_score <= 2,\n",
        "    \"Safe for Use\",\n",
        "    \"Needs Treatment\"\n",
        ")\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame({\n",
        "    \"pH_Band\": pH,\n",
        "    \"Turbidity\": turbidity,\n",
        "    \"TDS_Band\": tds,\n",
        "    \"Residual_Chlorine\": chlorine,\n",
        "    \"Microbial_Indicator\": microbial,\n",
        "    \"Source_Type\": source,\n",
        "    \"Class\": target\n",
        "})\n",
        "\n",
        "print(\"Dataset created successfully!\")\n",
        "print(\"Dataset shape:\", df.shape)"
      ],
